FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    SELLBIRD_HOME=/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir fastapi uvicorn httpx aiosqlite pydantic \
    python-dotenv pyyaml beautifulsoup4 psutil pytz

COPY sellbird/ sellbird/
COPY sellbird.yaml .
COPY frontend/dist/ frontend/dist/

RUN mkdir -p /app/data

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "sellbird.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
